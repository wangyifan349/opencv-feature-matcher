if __name__ == "__main__":
    # Load target testing source photograph from file workspace tree
    input_img = cv2.imread("face.jpg")

    if input_img is None:
        print(
            "[Error] Source asset file 'face.jpg' "
            "not found in workspace context root path."
        )
    else:
        # Tuning parameters initialization configurations block setup
        output_img = advanced_beauty_with_slimming(
            input_img,
            blur_radius=15,    # Spatial context kernel coverage sizing
            blur_alpha=0.7,    # Mixing balance factor threshold for skin textures
            whiten_beta=0.4,   # Non-linear exposure gain value allocation mapping
            ruddy=6,           # Dynamic saturation modification amplitude constant
            slim_strength=0.04 # Displacement percentage relative to facial diameter
        )

        # Tile images side-by-side to review changes
        compare = np.hstack((input_img, output_img))
        cv2.imshow(
